# Copy to public-demo.env on the VM. The real file is ignored by Git.
# Use a hostname you control, such as a free DuckDNS subdomain.
APP_DOMAIN=your-name.duckdns.org
APP_VERSION=0.1.0-cv-demo

# Generate these using: bash infra/public-demo/init-env.sh your-name.duckdns.org
POSTGRES_PASSWORD=
REDIS_PASSWORD=
AUTH_SIGNING_KEY=

# A working SMTP account is required for verification and password reset.
# Port 587 with STARTTLS is expected. Never put the password in Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
