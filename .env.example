# Copy to .env; supply your own local credentials. This file contains no secrets.
POSTGRES_DB=error_intelligence
POSTGRES_USER=error_intelligence
POSTGRES_PASSWORD=
POSTGRES_PORT=15432
REDIS_PASSWORD=
REDIS_PORT=6379
SERVER_PORT=8080
APP_VERSION=0.1.0-SNAPSHOT
FRONTEND_PORT=5173
# For a backend running on the host:
DB_URL=jdbc:postgresql://localhost:15432/error_intelligence
DB_USERNAME=error_intelligence
DB_PASSWORD=
REDIS_HOST=localhost
# Native development uses local PostgreSQL and Redis via WSL.
SPRING_PROFILES_ACTIVE=native
# Base64 encoding of at least 32 cryptographically random bytes.
AUTH_SIGNING_KEY=
AUTH_ISSUER=error-intelligence
# Local native profile writes verification/reset links to .local/mail.
# Hosted environments require HTTPS PUBLIC_APP_URL and SMTP delivery.
PUBLIC_APP_URL=http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
# Optional for real provider calls; never commit a real key.
OPENAI_API_KEY=
AI_DAILY_ANALYSIS_LIMIT=100
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT=PT12S
AI_RETRY_DELAY=PT15S
AI_MAX_ATTEMPTS=2
# Keep provider-backed jobs off in a no-cost local demo; opt in only with an API budget.
AI_WORKER_ENABLED=false
AI_EMBEDDING_WORKER_ENABLED=false
RAW_EVENT_RETENTION_DAYS=0
RAW_EVENT_RETENTION_INTERVAL=PT1M
AI_EMBEDDING_DAILY_CALLS=1000
AI_EMBEDDING_DAILY_CHARACTERS=1000000
# Keep NONE for direct access. Use NATIVE only behind a trusted private proxy.
FORWARDED_HEADERS_STRATEGY=NONE
SCHEDULER_POOL_SIZE=4
PROMETHEUS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACING_SAMPLE_PROBABILITY=0.1
